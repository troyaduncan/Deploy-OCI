# Port for the Express server (Vite proxy in dev mode also reads this)
PORT=3001

# Absolute path to deploy-oci.sh — update to your actual path
SCRIPT_PATH=/home/troy/projects/deploy-oci/deploy-oci.sh

# SQLite database file — use an ABSOLUTE path to avoid cwd ambiguity
# DB_PATH=/home/troy/projects/deploy-oci/data/deployments.db

# Optional: set to enable HTTP Basic Auth on all API routes
# DEPLOY_OCI_AUTH_PASSWORD=your-secret-here
